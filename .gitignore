# Build-Outputs (jederzeit reproduzierbar via `devenv shell -- pdfs`).
**/*.pdf
**/*.pptx

# Lokal erzeugte Veröffentlichungsfassung (CI baut sie für GitHub Pages)
public/

# Bilder, die NICHT ins öffentliche Repo dürfen (Copyright), aber lokal in den Folien
# erscheinen sollen. Der Ordner liegt im Projekt, damit auch die Slidev-Fassung den
# relativen Pfad auflösen kann; im Public-Build fehlen die Dateien bewusst — Marp
# ignoriert sie dann mit einer Warnung (kein Fehler, kein defektes Bild).
figures/copyrighted/

# Nix/devenv
.devenv/
.direnv/
node_modules/

# Slidev-Präsentationsfassung: vollständig generiert (tools/to-slidev.mjs),
# jederzeit reproduzierbar via `devenv shell -- slidev-convert|slidev-build`
slidev/

# ---------------------------------------------------------------------------
# NICHT für ein öffentliches Repo (Copyright, Fremdmaterial, personenbezogene Daten).
# Der Foliensatz selbst (.md + figures/*.svg), devenv.nix/tools/ und die
# Projekt-Guidelines sind davon nicht betroffen.
# ---------------------------------------------------------------------------

